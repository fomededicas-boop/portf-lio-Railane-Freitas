---
// Contato: frase de fechamento, a lista de canais e, se houver, uma foto em arco ao lado.
import { Image } from 'astro:assets';
import { c, linkDeContato, telefoneLegivel } from '../lib/site';

const { titulo, texto, foto, fotoDescricao, whatsapp, email, instagram, tiktok, midiaKit } = c.contato;
const canais = [
  whatsapp && { rede: 'WhatsApp', valor: telefoneLegivel(whatsapp.numero), href: linkDeContato('whatsapp'), fora: true },
  email && { rede: 'E-mail', valor: email, href: linkDeContato('email'), fora: false },
  instagram && { rede: 'Instagram', valor: `@${instagram}`, href: linkDeContato('instagram'), fora: true },
  tiktok && { rede: 'TikTok', valor: `@${tiktok}`, href: linkDeContato('tiktok'), fora: true },
  midiaKit && { rede: 'Mídia kit', valor: 'Abrir o mídia kit', href: /^https:/.test(midiaKit) ? midiaKit : `/${midiaKit}`, fora: true },
].filter((canal) => !!canal);
---

<section class:list={['secao', 'recuo', 'contato', { 'com-foto': foto }]} id="contato" aria-labelledby="contato-titulo">
  {
    foto && (
      <figure class="foto">
        <Image src={foto} alt={fotoDescricao ?? ''} width={440} densities={[1, 2]} />
      </figure>
    )
  }
  <div class="conteudo">
    <p class="kicker">Contato</p>
    <h2 id="contato-titulo">{titulo}</h2>
    {texto && <p class="texto">{texto}</p>}
    <ul class="canais">
      {
        canais.map((canal) => (
          <li>
            <a href={canal.href} {...(canal.fora ? { target: '_blank', rel: 'noopener' } : {})}>
              <span class="rede">{canal.rede}</span>
              <span class="valor">{canal.valor}</span>
              <span class="seta" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .kicker {
    color: var(--suave);
  }
  h2 {
    margin-top: 0.6rem;
    font-size: calc(clamp(2.25rem, 7vw, 4.25rem) * var(--escala));
    line-height: 1;
  }
  .texto {
    max-width: 34rem;
    margin-top: 1.25rem;
  }
  @media (max-width: 759px) {
    .kicker,
    h2 {
      text-align: center;
    }
    .texto {
      margin-inline: auto;
      text-align: center;
    }
  }

  /* Foto em arco branco (combina com fotos de fundo branco), com a mesma moldura da capa:
     uma forma verde deslocada atrás e um contorno solto na frente. */
  .foto {
    position: relative;
    isolation: isolate;
    width: min(70%, 17rem);
    margin: 0 auto 2.25rem;
  }
  .foto :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    border-radius: 999px 999px 24px 24px;
    background: #fff;
  }
  .foto::before,
  .foto::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 999px 999px 24px 24px;
  }
  .foto::before {
    background: #6f7f6a;
    transform: translate(14px, 14px);
  }
  .foto::after {
    z-index: 1;
    border: 2px solid var(--destaque);
    transform: translate(-10px, -10px);
    pointer-events: none;
  }

  .canais {
    margin-top: clamp(2rem, 5vw, 3rem);
  }
  .canais a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.2rem 1rem;
    padding-block: 0.95rem;
    border-top: 1px solid var(--linha);
    text-decoration: none;
  }
  .canais li:last-child a {
    border-bottom: 1px solid var(--linha);
  }
  .rede {
    grid-column: 1 / -1;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .valor {
    font-family: var(--f-titulo);
    font-weight: var(--peso-titulo);
    font-size: calc(clamp(1.3rem, 3.5vw, 1.85rem) * var(--escala));
    letter-spacing: var(--espaco-titulo);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }
  .seta {
    font-size: 1.4rem;
    transition: transform 0.15s ease;
  }
  .canais a:hover .valor {
    color: var(--destaque);
  }
  .canais a:hover .seta {
    transform: translate(3px, -3px);
  }
  @media (min-width: 760px) {
    .canais a {
      grid-template-columns: 12rem 1fr auto;
      column-gap: 2rem;
    }
    .rede {
      grid-column: auto;
    }
  }
  /* Computador: foto à direita e contatos à esquerda. */
  @media (min-width: 960px) {
    .com-foto {
      display: grid;
      grid-template-columns: 1fr minmax(16rem, 22rem);
      align-items: center;
      column-gap: clamp(3rem, 6vw, 5rem);
    }
    .com-foto .foto {
      grid-column: 2;
      grid-row: 1;
      width: 100%;
      margin: 0;
    }
    .com-foto .conteudo {
      grid-column: 1;
      grid-row: 1;
    }
  }
</style>

---
// Topo: nicho, nome, foto, bio e os botões de contato e de ver os vídeos.
import { Picture } from 'astro:assets';
import { siInstagram, siTiktok, siWhatsapp } from 'simple-icons';
import { c, linkDeContato, linkPrincipal, videosDaGrade } from '../lib/site';

const [primeiro, ...resto] = c.topo.nome.trim().split(/\s+/);
// O nome encolhe se tiver uma palavra muito comprida, para nunca sair da tela.
const letras = Math.max(...c.topo.nome.split(/\s+/).map((p) => p.length), 4);
const temVideos = !!c.videos?.mostrar && videosDaGrade.length > 0;
// Texto do selo: a função, com "&" virando estrelinha (ex.: "CREATOR UGC ✦ INFLUENCER ✦").
const selo = `${c.topo.funcao.split(/\s*&\s*/).join(' ✦ ')} ✦ `.toUpperCase();
// Ícones das redes (logos do Simple Icons). Só aparecem as que estão preenchidas em CONTATO.
const redes = [
  { nome: 'Instagram', icone: siInstagram, link: linkDeContato('instagram') },
  { nome: 'TikTok', icone: siTiktok, link: linkDeContato('tiktok') },
  { nome: 'WhatsApp', icone: siWhatsapp, link: linkDeContato('whatsapp') },
].filter((r) => r.link);
---

<section class="topo" aria-labelledby="nome" style={`--letras:${letras}`}>
<div class="recuo capa">
  <div class="titulo">
    <p class="kicker"><span class="funcao">{c.topo.funcao}</span> <span class="nicho">{c.topo.nicho}</span></p>
    <h1 id="nome">{primeiro}{resto.length > 0 && <em>{resto.join(' ')}</em>}</h1>
  </div>
  <figure class:list={['foto', { recortada: c.topo.fotoRecortada }]}>
    {c.topo.fotoRecortada && <div class="arco" />}
    <Picture
      src={c.topo.fotoRecortada ?? c.topo.foto}
      alt={c.topo.fotoDescricao}
      widths={[360, 540, 720, 1080]}
      sizes="(min-width: 860px) 34vw, 80vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
    />
    {/* Selo redondo girando no canto da foto. Só aparece nos temas que ligam (ex.: 'railane'). */}
    <svg class="selo" viewBox="0 0 120 120" aria-hidden="true">
      <defs><path id="selo-circulo" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" /></defs>
      <circle cx="60" cy="60" r="58" fill="#E8DED3" />
      <g class="selo-texto">
        <text font-size="11.5" font-weight="600" fill="#1F1A17">
          <textPath href="#selo-circulo" textLength="272" lengthAdjust="spacing">{selo}</textPath>
        </text>
      </g>
      <text x="60" y="60" text-anchor="middle" dominant-baseline="central" font-size="26" fill="#E75C16">✦</text>
    </svg>
  </figure>
  <div class="intro">
    <p class="bio">{c.topo.bio}</p>
    <div class="acoes">
      <a class="botao" href={linkPrincipal}>{c.topo.botao.texto} <span aria-hidden="true">→</span></a>
      {temVideos && <a class="ver" href="#videos">Ver meu trabalho <span aria-hidden="true">↓</span></a>}
    </div>
    {
      redes.length > 0 && (
        <ul class="redes">
          {redes.map((r) => (
            <li>
              <a href={r.link} target="_blank" rel="noopener noreferrer" aria-label={`${r.nome} de ${c.topo.nome}`} title={r.nome}>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path d={r.icone.path} fill="currentColor" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
</section>

<style>
  .capa {
    display: grid;
    gap: 1.75rem;
    padding-top: clamp(2rem, 6vw, 4.5rem);
  }
  .titulo {
    /* O nome mede a própria coluna (100cqi) para nunca quebrar no meio da palavra. */
    container-type: inline-size;
  }
  .kicker {
    margin-bottom: 0.9rem;
    color: var(--suave);
  }
  /* Função numa linha e os nichos embaixo, um pouco menores. */
  .kicker span {
    display: block;
  }
  .kicker .nicho {
    margin-top: 0.35rem;
    font-size: 0.92em;
    letter-spacing: 0.1em;
  }
  h1 {
    font-size: min(calc(clamp(3rem, 13vw, 6.25rem) * var(--escala)), calc(100cqi / (var(--letras) * var(--letra))));
    line-height: 0.95;
  }
  h1 em {
    display: block;
    font-style: var(--italico);
    color: var(--destaque);
  }
  .foto {
    width: min(80%, 22rem);
  }
  .foto :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: max(var(--raio), 16px);
  }
  /* Foto recortada: o arco ocupa a parte de baixo e a cabeça sai por cima dele.
     --arco = altura do arco em relação à foto inteira. */
  .foto.recortada {
    --arco: 78%;
    position: relative;
  }
  .arco {
    position: absolute;
    inset: auto 0 0;
    height: var(--arco);
    border-radius: 999px 999px 24px 24px;
    background: var(--superficie);
  }
  .foto.recortada :global(picture) {
    position: relative;
    display: block;
  }
  .foto.recortada :global(img) {
    aspect-ratio: auto;
    object-fit: contain;
    border-radius: 0 0 24px 24px;
  }
  .foto.recortada .selo {
    z-index: 1;
  }
  .selo {
    display: none;
    position: absolute;
    left: -1.5rem;
    bottom: 1.5rem;
    width: clamp(5.5rem, 22vw, 7.5rem);
    height: auto;
    filter: drop-shadow(0 6px 14px rgb(0 0 0 / 0.18));
  }
  .selo-texto {
    transform-origin: 60px 60px;
    animation: girar 18s linear infinite;
  }
  @keyframes girar {
    to {
      transform: rotate(1turn);
    }
  }
  .bio {
    max-width: 32rem;
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
  }
  .acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  /* Redes sociais: botões redondos discretos, com a logo de cada rede. */
  .redes {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .redes a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--linha);
    border-radius: 50%;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .redes a:hover {
    border-color: var(--texto);
    background: var(--texto);
    color: var(--fundo);
  }
  .ver {
    font-weight: 600;
    text-decoration: none;
  }
  .ver:hover {
    text-decoration: underline;
  }
  /* Celular: tudo centralizado, com a foto no meio. */
  @media (max-width: 859px) {
    .capa {
      justify-items: center;
      text-align: center;
    }
    /* O nome precisa da largura toda: ele mede a coluna para escolher o tamanho. */
    .titulo,
    .intro {
      justify-self: stretch;
    }
    .bio {
      margin-inline: auto;
    }
    .acoes,
    .redes {
      justify-content: center;
    }
  }
  @media (min-width: 860px) {
    .capa {
      grid-template-columns: 1.4fr 1fr;
      grid-template-areas: 'titulo foto' 'intro foto';
      column-gap: clamp(2rem, 5vw, 5rem);
      align-items: end;
    }
    .titulo {
      grid-area: titulo;
    }
    .foto {
      grid-area: foto;
      width: min(100%, 26rem);
      justify-self: end;
      align-self: center;
    }
    .intro {
      grid-area: intro;
      align-self: start;
    }
  }
</style>

---
// Vídeos verticais. Com 2 nichos ou mais, aparecem separados por nicho (todos abertos, um
// bloco embaixo do outro), com atalhos no alto que acompanham a rolagem.
import Cabecalho from './Cabecalho.astro';
import VideoCard from './VideoCard.astro';
import { c, videosDaGrade, chaveDoNicho, type Video } from '../lib/site';

const v = c.videos!;

// Agrupa na ordem em que os nichos aparecem na lista; vídeos sem nicho vão para o fim.
const grupos = new Map<string, { nome: string; chave: string; videos: Video[] }>();
for (const video of videosDaGrade) {
  const chave = video.nicho ? chaveDoNicho(video.nicho) : 'outros';
  if (!grupos.has(chave)) grupos.set(chave, { nome: video.nicho || 'Outros vídeos', chave, videos: [] });
  grupos.get(chave)!.videos.push(video);
}
// Com a lista `videos.nichos` preenchida, os nichos seguem a ordem dela; os que não têm vídeo não aparecem.
const ordem = v.nichos.map(chaveDoNicho);
const posicao = (chave: string) => (chave === 'outros' ? Infinity : ordem.includes(chave) ? ordem.indexOf(chave) : ordem.length);
const lista = [...grupos.values()].sort((a, b) => posicao(a.chave) - posicao(b.chave));
const porNicho = lista.length >= 2;
---

<section class="secao recuo" id="videos" aria-labelledby="videos-titulo">
  <Cabecalho titulo={v.titulo} id="videos-titulo" />
  {v.texto && <p class="texto">{v.texto}</p>}
  {
    porNicho && (
      <nav class="atalhos" aria-label="Ir para um nicho">
        <ul>
          {lista.map((g) => (
            <li>
              <a href={`#nicho-${g.chave}`}>{g.nome}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  {
    lista.map((g) => (
      <div class="grupo" id={porNicho ? `nicho-${g.chave}` : undefined}>
        {porNicho && (
          <h3>{g.nome}</h3>
        )}
        <ul class="grade">
          {g.videos.map((video) => (
            <li>
              <VideoCard video={video} />
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>

<style>
  .texto {
    max-width: 34rem;
    margin: -0.75rem 0 1.5rem;
    color: var(--suave);
  }
  /* Atalhos dos nichos. No computador ficam presos abaixo do cabeçalho enquanto a marca rola. */
  .atalhos ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  /* Botões pequenos e iguais: letra miúda em caixa alta, com o mesmo espaço em todos. */
  .atalhos a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.35em 0.95em;
    border: 1px solid var(--linha);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .atalhos a:hover {
    border-color: var(--destaque);
    background: var(--destaque);
    color: var(--no-destaque);
  }
  .grupo {
    /* O título do nicho para logo abaixo do cabeçalho fixo (que no celular tem duas linhas). */
    scroll-margin-top: 6.25rem;
  }
  .grupo + .grupo {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }
  .atalhos + .grupo {
    margin-top: 1.75rem;
  }
  h3 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 1rem;
    font-size: calc(clamp(1.4rem, 3.5vw, 1.9rem) * var(--escala));
  }
  .grade {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  @media (max-width: 759px) {
    .texto {
      margin-inline: auto;
      text-align: center;
    }
    h3 {
      justify-content: center;
    }
    /* Celular: os nichos numa linha só, que desliza para o lado, de ponta a ponta da tela. */
    .atalhos {
      margin-inline: calc(-1 * clamp(1rem, 5vw, 3rem));
    }
    .atalhos ul {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      padding: 0.25rem clamp(1rem, 5vw, 3rem);
      scroll-padding-inline: clamp(1rem, 5vw, 3rem);
      /* Esmaece a ponta direita para mostrar que tem mais nichos ao arrastar. */
      mask-image: linear-gradient(to right, #000 82%, transparent);
    }
    .atalhos ul::-webkit-scrollbar {
      display: none;
    }
    .atalhos li {
      flex: none;
    }
  }
  /* A partir daqui o cabeçalho tem uma linha só (3,75rem), e os atalhos ficam presos logo abaixo. */
  @media (min-width: 900px) {
    .atalhos {
      position: sticky;
      top: 3.75rem;
      z-index: 5;
      margin-inline: calc(-1 * clamp(1rem, 5vw, 3rem));
      padding: 0.6rem clamp(1rem, 5vw, 3rem);
      background: var(--fundo);
    }
    .grupo {
      scroll-margin-top: 8.5rem;
    }
  }
  /* 2 colunas no celular e 4 a partir do tablet: um nicho com 4 vídeos fecha a linha certinho. */
  @media (min-width: 640px) {
    .grade {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
  }
  @media (min-width: 1024px) {
    .grade {
      gap: 1.25rem;
    }
  }
</style>
